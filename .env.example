# Copy this file to .env and replace the blank JWT_SECRET with a fresh random key.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DATABASE_URL=sqlite:////data/app.db

# Set to 1 only when running behind the bundled TLS-terminating Nginx proxy.
ENFORCE_HTTPS=1
TRUST_PROXY=1
CORS_ORIGINS=https://localhost

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_WINDOW=60
